SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

DEFAULT_MODEL_ID=deepseek-v4-flash

# demo: use the built-in labels only for the two verified competition samples (default).
# evidence: use detection evidence for every upload.
REPORT_DECISION_MODE=demo

# 游客模式可留空；登录、注册、个人中心与分析历史需要数据库。
# 默认使用 SQLite，无需启动独立数据库服务。相对路径以 backend/ 为基准。
DATABASE_URL=sqlite:///data/c2sherlock.sqlite3

# Linux 绝对路径示例：
# DATABASE_URL=sqlite:////home/yjc/projects/Xonme/backend/data/c2sherlock.sqlite3

# MySQL 示例（不要填写真实密码）：
# DATABASE_URL=mysql+pymysql://c2sherlock_user:replace_with_your_password@127.0.0.1:3306/c2sherlock?charset=utf8mb4

# 本地前端开发服务器；局域网部署时改为对应前端来源。
CORS_ORIGIN_REGEX=^https?://(localhost|127[.]0[.]0[.]1)(:[0-9]+)?$
