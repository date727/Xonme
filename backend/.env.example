SILICONFLOW_BASE_URL=
SILICONFLOW_API_KEY=

# GPT-5.5 uses your own OpenAI account, not SiliconFlow.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
DEFAULT_MODEL_ID=deepseek-v4-flash

# MySQL application database. Do not use the MySQL root account here.
# If the password includes @, :, /, ?, # or %, URL-encode those characters.
DATABASE_URL=mysql+pymysql://c2sherlock_user:replace_with_your_password@127.0.0.1:3306/c2sherlock?charset=utf8mb4

# Optional: leave blank to generate and persist backend/.jwt_secret automatically.
# If set, use a random value with at least 32 characters and keep it private.
JWT_SECRET=
# Keep false for local HTTP development. Set true after HTTPS deployment.
COOKIE_SECURE=false
# Keep localhost for development. Set this to your HTTPS domain regex when deployed.
CORS_ORIGIN_REGEX=^https?://(localhost|127[.]0[.]0[.]1|192[.]168[.]153[.]1)(:[0-9]+)?$

