{
  "feature_cols": [
    "flow_gap",
    "log_flow_gap",
    "gap_rolling_mean",
    "gap_rolling_std",
    "gap_rolling_cv",
    "gap_rolling_median",
    "gap_rolling_iqr",
    "duration",
    "orig_packets",
    "resp_packets",
    "orig_bytes",
    "resp_bytes",
    "packet_ratio",
    "byte_ratio",
    "packet_iat_min",
    "packet_iat_max",
    "packet_iat_mean",
    "packet_iat_stddev",
    "packet_iat_0",
    "packet_iat_1",
    "packet_iat_2",
    "packet_iat_3",
    "packet_iat_4",
    "direction_confidence"
  ],
